FROM dhi.io/node:24-debian13-dev AS builder

WORKDIR /home/node/app

COPY package*.json ./

RUN npm ci --omit=dev

COPY ./src ./src
RUN mkdir -p /home/node/app/data

FROM dhi.io/node:24-debian13

WORKDIR /home/node/app

COPY --from=builder --chown=65532:65532 /home/node/app /home/node/app
USER 65532

EXPOSE 4046

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
	CMD node -e "fetch('http://127.0.0.1:4046/healthz').then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "src/index.js"]