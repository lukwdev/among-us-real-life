:80 {
    route {
        # Keep the public entry point in the frontend container while
        # forwarding API and Socket.IO traffic to the backend service.
        @backend path /api /api/* /socket.io /socket.io/* /healthz
        reverse_proxy @backend backend:4046

        handle {
            root * /srv
            try_files {path} {path}/ /index.html
            file_server
        }
    }
}
