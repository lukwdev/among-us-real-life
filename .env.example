ADMIN_CODE=replace-with-a-long-random-admin-password

# Optional Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@example.com

# Optional: restrict Socket.IO CORS to your public site origin(s), comma-separated.
# Example: CORS_ORIGIN=https://among.example.com
CORS_ORIGIN=

# Address/port for the reverse proxy to reach this app.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
