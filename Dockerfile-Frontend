FROM dhi.io/node:24-debian13-dev AS builder

WORKDIR /usr/src/app

COPY ./web/package.json ./web/package-lock.json /usr/src/app/

RUN npm ci

COPY ./web /usr/src/app

RUN npm run build

FROM dhi.io/caddy:2.11-debian13
COPY web/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /usr/src/app/dist /srv
USER 65532
